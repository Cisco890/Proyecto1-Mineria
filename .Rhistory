drop_na2 <- function(df, a, b){
df %>% filter(!is.na(.data[[a]]), !is.na(.data[[b]]))
}
# 1) Sexo vs Estado civil
df1 <- drop_na2(violencia_cat, "sexo_cat", "est_civ_cat")
