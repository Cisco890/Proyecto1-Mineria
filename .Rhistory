cluster_data <- datos_dep %>%
select(casos_violencia, casos_divorcio)
cluster_scaled <- scale(cluster_data)
wss <- numeric(10)
for (k in 1:10) {
kmeans_model <- kmeans(cluster_scaled, centers = k, nstart = 25)
wss[k] <- kmeans_model$tot.withinss
}
plot(1:10, wss,
type = "b",
pch = 19,
frame = FALSE,
xlab = "Número de clusters",
ylab = "Within-cluster sum of squares",
main = "Método del Codo")
library(cluster)
sil_width <- numeric(10)
for (k in 2:10) {
kmeans_model <- kmeans(cluster_scaled, centers = k, nstart = 25)
ss <- silhouette(kmeans_model$cluster, dist(cluster_scaled))
sil_width[k] <- mean(ss[, 3])
}
plot(2:10, sil_width[2:10],
type = "b",
pch = 19,
frame = FALSE,
xlab = "Número de clusters",
ylab = "Silhouette width",
main = "Método de la Silueta")
set.seed(123)  # Para reproducibilidad
kmeans_model <- kmeans(cluster_scaled, centers = 2, nstart = 25)
datos_dep$cluster <- factor(kmeans_model$cluster)
datos_dep
datos_dep %>%
group_by(cluster) %>%
summarise(
promedio_violencia = mean(casos_violencia),
promedio_divorcio = mean(casos_divorcio),
n_departamentos = n()
)
