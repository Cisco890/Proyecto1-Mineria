),
edu_hom_cat = if ("nivel_edu_hom" %in% names(.)) nivel_edu_hom else as.character(ESCHOM),
edu_muj_cat = if ("nivel_edu_muj" %in% names(.)) nivel_edu_muj else as.character(ESCMUJ)
)
