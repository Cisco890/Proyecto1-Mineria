# Calculamos predicciones LOOCV del modelo final para métricas completas
n      <- nrow(datos_std)
real_v <- numeric(n)
pred_v <- numeric(n)
for (i in seq_len(n)) {
fit       <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital,
data = datos_std[-i, ]
)
pred_v[i] <- predict(fit, newdata = datos_std[i, ], type = "response")
real_v[i] <- datos_std$casos_divorcio[i]
}
mae_final  <- mean(abs(real_v - pred_v))
rmse_final <- sqrt(mean((real_v - pred_v)^2))
mape_final <- mean(abs((real_v - pred_v) / real_v)) * 100
metricas_tbl <- tibble(
Métrica     = c("MAE", "RMSE", "MAPE (%)"),
Valor       = round(c(mae_final, rmse_final, mape_final), 1),
Descripción = c(
"Error promedio en número de divorcios — métrica principal",
"Error cuadrático medio — penaliza más los errores grandes",
"Error porcentual promedio — independiente de la escala"
)
)
kable(metricas_tbl,
caption = "Métricas de error del Modelo Final (validación LOOCV).")
datos_std <- datos_std %>%
mutate(
res_pearson = residuals(m1, type = "pearson"),
pred_m1_fit = fitted(m1)
)
p_res <- ggplot(datos_std,
aes(x = pred_m1_fit, y = res_pearson,
color = factor(es_capital))) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
geom_hline(yintercept = c(-2, 2), linetype = "dotted",
color = "orange", linewidth = 0.7) +
geom_point(size = 2.5, alpha = 0.85) +
scale_color_manual(values = c("0" = "#2E86C1", "1" = "#E74C3C"),
labels  = c("Interior", "Capital"), name = "") +
labs(title = "Residuales de Pearson vs. ajustados",
x = "Valores ajustados", y = "Residual de Pearson") +
theme_minimal() +
theme(legend.position = "bottom")
p_qq <- ggplot(datos_std, aes(sample = res_pearson)) +
stat_qq(color = "#2E86C1") +
stat_qq_line(color = "red", linetype = "dashed") +
labs(title = "Q-Q plot de residuales",
x = "Cuantiles teóricos", y = "Cuantiles observados") +
theme_minimal()
grid.arrange(p_res, p_qq, ncol = 2)
ggplot(datos_std,
aes(x = pred_m1, y = casos_divorcio,
color = factor(es_capital))) +
geom_abline(slope = 1, intercept = 0,
linetype = "dashed", color = "gray50", linewidth = 0.8) +
geom_point(size = 3, alpha = 0.85) +
scale_color_manual(values = c("0" = "#2E86C1", "1" = "#E74C3C"),
labels  = c("Interior", "Capital"), name = "") +
labs(title = "Real vs. Predicho — Modelo Final (M1)",
