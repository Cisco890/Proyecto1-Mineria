p_qq <- ggplot(datos_std, aes(sample = res_pearson)) +
stat_qq(color = "#2E86C1") +
stat_qq_line(color = "red", linetype = "dashed") +
labs(title = "Q-Q plot de residuales",
x = "Cuantiles teóricos", y = "Cuantiles observados") +
theme_minimal()
grid.arrange(p_res, p_qq, ncol = 2)
# Calcular predicciones LOOCV del modelo final para métricas completas
n      <- nrow(datos_std)
real_v <- numeric(n)
pred_v <- numeric(n)
for (i in seq_len(n)) {
fit       <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + pct_urbano_z,
data = datos_std[-i, ]
)
pred_v[i] <- predict(fit, newdata = datos_std[i, ], type = "response")
real_v[i] <- datos_std$casos_divorcio[i]
}
rmse_final <- sqrt(mean((real_v - pred_v)^2))
mae_final  <- mean(abs(real_v - pred_v))
mape_final <- mean(abs((real_v - pred_v) / real_v)) * 100
dev_poi    <- 2 * sum(real_v * log(real_v / (pred_v + 1e-9)) -
(real_v - pred_v))
metricas_tbl <- tibble(
Métrica     = c("RMSE", "MAE", "MAPE (%)", "Desviación Poisson (LOOCV)"),
Valor       = round(c(rmse_final, mae_final, mape_final, dev_poi), 1),
Descripción = c(
"Error cuadrático medio; penaliza errores grandes",
"Error absoluto medio; más robusto al outlier de la capital",
"Error porcentual medio; interpretación independiente de escala",
"Métrica de ajuste estándar para modelos de conteo; menor = mejor"
)
)
kable(metricas_tbl,
caption = "Métricas de error del Modelo Final (validación LOOCV).")
loocv_nb <- function(formula, data) {
n   <- nrow(data)
sq  <- numeric(n)
ab  <- numeric(n)
for (i in seq_len(n)) {
fit   <- MASS::glm.nb(formula, data = data[-i, ])
pred  <- predict(fit, newdata = data[i, ], type = "response")
err   <- data$casos_divorcio[i] - pred
sq[i] <- err^2
ab[i] <- abs(err)
}
list(RMSE = sqrt(mean(sq)), MAE = mean(ab))
}
m1 <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital,
data = datos_std)
m2 <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + pct_urbano_z,
data = datos_std)
m3 <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z * es_capital +
edad_prom_victima_z + pct_urbano_z,
data = datos_std)
m_final <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z * es_capital +
edad_prom_victima_z + pct_urbano_z + hijos_prom_z,
data = datos_std)
cv1 <- loocv_nb(casos_divorcio ~ violencia_total_z + es_capital, datos_std)
cv2 <- loocv_nb(casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + pct_urbano_z, datos_std)
cv3 <- loocv_nb(casos_divorcio ~ violencia_total_z * es_capital +
edad_prom_victima_z + pct_urbano_z, datos_std)
cvf <- loocv_nb(casos_divorcio ~ violencia_total_z * es_capital +
edad_prom_victima_z + pct_urbano_z + hijos_prom_z, datos_std)
comparacion <- tibble(
Modelo       = c("M1: Línea base", "M2: Base teórico",
"M3: Interacción", "M-Final: Completo"),
`# Param.`   = c(2, 4, 5, 6),
AIC          = round(c(AIC(m1), AIC(m2), AIC(m3), AIC(m_final)), 1),
`Theta (θ)`  = round(c(m1$theta, m2$theta, m3$theta, m_final$theta), 2),
`RMSE LOOCV` = round(c(cv1$RMSE, cv2$RMSE, cv3$RMSE, cvf$RMSE), 0),
`MAE LOOCV`  = round(c(cv1$MAE,  cv2$MAE,  cv3$MAE,  cvf$MAE),  0)
)
kable(comparacion,
caption = paste("Comparación de modelos. MAE-LOOCV es la métrica",
"principal: más robusta que RMSE ante el outlier",
"del Departamento de Guatemala."))
