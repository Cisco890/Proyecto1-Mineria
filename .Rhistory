library(tidyverse)
library(MASS)       # glm.nb()
library(broom)      # tidy()
library(knitr)
library(ggplot2)
library(gridExtra)
# ── 1. Agregar violencia por departamento ────────────────────────────────────
vio_dep <- violencia %>%
filter(!is.na(cod_depto), cod_depto != 99) %>%
group_by(cod_depto) %>%
summarise(
violencia_total    = n(),
edad_prom_victima  = mean(vic_edad_clean,    na.rm = TRUE),
hijos_prom         = mean(total_hijos_clean, na.rm = TRUE),
pct_mujeres        = mean(vic_sexo == 2,      na.rm = TRUE) * 100,
pct_urbano         = mean(hec_area == 1,      na.rm = TRUE) * 100,
pct_casados        = mean(vic_est_civ == 2,   na.rm = TRUE) * 100,
.groups = "drop"
)
# ── 2. Agregar divorcios por departamento ────────────────────────────────────
div_dep <- divorcios %>%
filter(!is.na(cod_depto), cod_depto != 99) %>%
group_by(cod_depto) %>%
summarise(casos_divorcio = n(), .groups = "drop")
# ── 3. Unir y crear variable dummy para el outlier metropolitano ─────────────
datos_modelo <- vio_dep %>%
inner_join(div_dep, by = "cod_depto") %>%
mutate(
es_capital = as.integer(cod_depto == 1)   # 1 = Depto Guatemala, 0 = resto
)
kable(
datos_modelo %>%
select(cod_depto, violencia_total, casos_divorcio, es_capital,
edad_prom_victima, hijos_prom, pct_mujeres, pct_urbano, pct_casados) %>%
arrange(cod_depto),
digits  = 1,
caption = "Dataset final: 22 departamentos con indicadores (2022)"
)
knitr::opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE)
# IMPORTANTE: tidyverse PRIMERO, luego MASS
# Así tidyverse pisa a MASS y select() de dplyr queda activo
library(tidyverse)
library(MASS)        # glm.nb() — carga DESPUÉS de tidyverse
library(broom)       # tidy() para tablas de coeficientes
library(knitr)
library(ggplot2)
library(gridExtra)
# Resolver el conflicto explícitamente:
# Forzar que select, filter y mutate sean siempre los de dplyr
select <- dplyr::select
filter <- dplyr::filter
mutate <- dplyr::mutate
# ── Cargar los datasets originales ──────────────────────────────────────────
# Ajusta las rutas si tus CSV están en otra carpeta
divorcios <- read_csv("Datos/divorcios_total.csv")
violencia <- read_csv("Datos/violencia_total.csv")
# ── Limpieza de violencia (igual que en proyecto1.Rmd) ──────────────────────
violencia <- violencia %>%
mutate(
cod_depto        = floor(hec_deptomcpio / 100),
sexo_label       = case_when(vic_sexo == 1 ~ "Hombre",
vic_sexo == 2 ~ "Mujer",
TRUE ~ "Ignorado"),
vic_edad_clean   = ifelse(vic_edad > 110, NA, vic_edad),
total_hijos_clean = ifelse(total_hijos == 99, NA, total_hijos),
est_civ_label    = case_when(vic_est_civ == 1 ~ "Soltero(a)",
vic_est_civ == 2 ~ "Casado(a)",
vic_est_civ == 3 ~ "Unido(a)",
TRUE ~ "Ignorado"),
relacion_label   = case_when(vic_rel_agr == 1 ~ "Esposo/Conviviente",
vic_rel_agr == 2 ~ "Ex-Esposo/Ex-Pareja",
vic_rel_agr == 3 ~ "Padre/Madre",
vic_rel_agr == 4 ~ "Hijo(a)",
vic_rel_agr == 5 ~ "Hermano(a)",
TRUE ~ "Otro/No especificado")
)
# ── Limpieza de divorcios (igual que en proyecto1.Rmd) ──────────────────────
divorcios <- divorcios %>%
mutate(
cod_depto       = DEPOCU,
edad_hom_clean  = ifelse(EDADHOM > 110, NA, EDADHOM),
edad_muj_clean  = ifelse(EDADMUJ > 110, NA, EDADMUJ),
diferencia_edad = edad_hom_clean - edad_muj_clean
)
# ── Construir dataset departamental final ────────────────────────────────────
vio_dep <- violencia %>%
filter(!is.na(cod_depto), cod_depto != 99) %>%
group_by(cod_depto) %>%
summarise(
violencia_total   = n(),
edad_prom_victima = mean(vic_edad_clean,     na.rm = TRUE),
hijos_prom        = mean(total_hijos_clean,  na.rm = TRUE),
pct_mujeres       = mean(vic_sexo == 2,       na.rm = TRUE) * 100,
pct_urbano        = mean(hec_area == 1,        na.rm = TRUE) * 100,
pct_casados       = mean(vic_est_civ == 2,     na.rm = TRUE) * 100,
.groups = "drop"
)
div_dep <- divorcios %>%
filter(!is.na(cod_depto), cod_depto != 99) %>%
group_by(cod_depto) %>%
summarise(casos_divorcio = n(), .groups = "drop")
# Unir y crear dummy para el outlier metropolitano
datos_modelo <- vio_dep %>%
inner_join(div_dep, by = "cod_depto") %>%
mutate(
es_capital = as.integer(cod_depto == 1)  # 1 = Depto Guatemala, 0 = resto
)
kable(
datos_modelo %>%
dplyr::select(cod_depto, violencia_total, casos_divorcio,
es_capital, edad_prom_victima, hijos_prom,
pct_mujeres, pct_urbano, pct_casados) %>%
arrange(cod_depto),
digits  = 1,
caption = "Dataset final: 22 departamentos con indicadores (2022)"
)
stats_div <- datos_modelo %>%
summarise(
Mínimo   = min(casos_divorcio),
Q1       = quantile(casos_divorcio, 0.25),
Mediana  = median(casos_divorcio),
Media    = round(mean(casos_divorcio), 0),
Q3       = quantile(casos_divorcio, 0.75),
Máximo   = max(casos_divorcio),
Varianza = round(var(casos_divorcio), 0)
)
kable(stats_div,
caption = "Estadísticas descriptivas de la variable respuesta")
# Modelo diagnóstico para calcular Cook's Distance
mod_diag <- MASS::glm.nb(
casos_divorcio ~ violencia_total + es_capital + edad_prom_victima,
data = datos_modelo
)
cook_d  <- cooks.distance(mod_diag)
umbral  <- 4 / nrow(datos_modelo)
datos_modelo <- datos_modelo %>%
mutate(
cook_dist    = cook_d,
es_influyente = cook_d > umbral
)
ggplot(datos_modelo,
aes(x = reorder(factor(cod_depto), cook_dist),
y = cook_dist,
fill = es_influyente)) +
geom_col(alpha = 0.85) +
geom_hline(yintercept = umbral, color = "red",
linetype = "dashed", linewidth = 0.8) +
scale_fill_manual(
values = c("FALSE" = "#AED6F1", "TRUE" = "#E74C3C"),
labels = c("Normal", "Alta influencia"),
name   = ""
) +
annotate("text", x = 3, y = umbral + 0.004,
label = paste0("Umbral 4/n = ", round(umbral, 3)),
color = "red", size = 3) +
labs(
title = "Distancia de Cook por departamento",
x = "Código de departamento", y = "Distancia de Cook"
) +
theme_minimal() +
theme(axis.text.x = element_text(size = 7))
vars_pred <- c("violencia_total", "edad_prom_victima", "hijos_prom",
"pct_mujeres", "pct_urbano", "pct_casados")
# Estandarización Z-score de las predictoras numéricas
# es_capital NO se estandariza (ya es binaria 0/1)
datos_std <- datos_modelo %>%
mutate(across(all_of(vars_pred),
~ as.numeric(scale(.)),
.names = "{.col}_z"))
# ── Función de LOOCV para Binomial Negativa ──────────────────────────────────
loocv_nb <- function(formula, data) {
n    <- nrow(data)
errs <- numeric(n)
for (i in seq_len(n)) {
fit     <- MASS::glm.nb(formula, data = data[-i, ])
pred    <- predict(fit, newdata = data[i, ], type = "response")
errs[i] <- (data$casos_divorcio[i] - pred)^2
}
sqrt(mean(errs))
}
# ── Modelo 1: Línea base ─────────────────────────────────────────────────────
# Solo violencia + dummy capital. Establece el piso de comparación.
m1 <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital,
data = datos_std
)
# ── Modelo 2: Base teórico ───────────────────────────────────────────────────
# Incorpora las 3 variables principales del Avance 2:
# violencia, edad promedio de víctimas e hijos promedio
m2 <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + hijos_prom_z,
data = datos_std
)
# ── Modelo 3: Extendido ──────────────────────────────────────────────────────
# Todas las variables sociodemográficas disponibles.
# Con n=22 y 7 parámetros, este modelo está en riesgo de sobreajuste.
m3 <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + hijos_prom_z +
pct_mujeres_z + pct_urbano_z + pct_casados_z,
data = datos_std
)
# ── Modelo Final: Parsimonioso (mejor combinación) ───────────────────────────
# Seleccionado por menor AIC y menor RMSE-LOOCV en comparación con M1-M3.
# Incluye violencia, capital, edad promedio y proporción urbana.
# pct_urbano captura el acceso institucional para formalizar el divorcio
# (García-Mora et al., 2023).
m_final <- MASS::glm.nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + pct_urbano_z,
data = datos_std
)
# Calcular RMSE-LOOCV para cada modelo
rmse1 <- loocv_nb(
casos_divorcio ~ violencia_total_z + es_capital,
datos_std)
rmse2 <- loocv_nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + hijos_prom_z,
datos_std)
rmse3 <- loocv_nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + hijos_prom_z +
pct_mujeres_z + pct_urbano_z + pct_casados_z,
datos_std)
rmse_f <- loocv_nb(
casos_divorcio ~ violencia_total_z + es_capital +
edad_prom_victima_z + pct_urbano_z,
datos_std)
comparacion <- tibble(
Modelo        = c("M1: Línea base", "M2: Base teórico",
"M3: Extendido",  "M-Final: Parsimonioso"),
`# Predictores` = c(2, 4, 7, 4),
AIC           = round(c(AIC(m1), AIC(m2), AIC(m3), AIC(m_final)), 1),
`Theta (θ)`   = round(c(m1$theta, m2$theta, m3$theta, m_final$theta), 2),
`RMSE LOOCV`  = round(c(rmse1, rmse2, rmse3, rmse_f), 0)
)
kable(comparacion,
caption = paste(
"Comparación de modelos Binomial Negativa.",
"AIC menor = mejor ajuste penalizando complejidad.",
"RMSE-LOOCV menor = mejor generalización fuera de muestra."
))
comp_long <- comparacion %>%
dplyr::select(Modelo, AIC, `RMSE LOOCV`) %>%
pivot_longer(-Modelo, names_to = "Métrica", values_to = "Valor") %>%
mutate(Modelo = factor(Modelo, levels = comparacion$Modelo))
ggplot(comp_long, aes(x = Modelo, y = Valor, fill = Modelo)) +
geom_col(alpha = 0.85) +
facet_wrap(~ Métrica, scales = "free_y") +
scale_fill_manual(
values = c("#AED6F1", "#5DADE2", "#1A5276", "#2ECC71")
) +
labs(title = "AIC y RMSE-LOOCV por modelo",
x = NULL, y = "Valor") +
theme_minimal() +
theme(axis.text.x  = element_text(angle = 35, hjust = 1, size = 7),
legend.position = "none")
coef_tbl <- broom::tidy(m_final, exponentiate = TRUE, conf.int = TRUE) %>%
filter(term != "(Intercept)") %>%
mutate(
term = recode(term,
"violencia_total_z"   = "Violencia total (estand.)",
"es_capital"          = "Es capital (dummy)",
"edad_prom_victima_z" = "Edad prom. víctima (estand.)",
"pct_urbano_z"        = "% Área urbana (estand.)"
)
) %>%
dplyr::select(
Variable = term,
IRR      = estimate,
`IC 95% Inf` = conf.low,
`IC 95% Sup` = conf.high,
`p-valor`    = p.value
) %>%
mutate(across(where(is.numeric), ~ round(., 3)))
kable(coef_tbl,
caption = paste(
"Coeficientes del Modelo Final expresados como IRR",
"(Incidence Rate Ratio).",
"IRR > 1: incremento en divorcios; IRR < 1: reducción.",
"IC 95% que no cruza 1 indica significancia estadística."
))
coef_plot <- broom::tidy(m_final, exponentiate = TRUE, conf.int = TRUE) %>%
filter(term != "(Intercept)") %>%
mutate(
term = recode(term,
"violencia_total_z"   = "Violencia total",
"es_capital"          = "Es capital",
"edad_prom_victima_z" = "Edad prom. víctima",
"pct_urbano_z"        = "% Área urbana"
)
)
ggplot(coef_plot,
aes(x = reorder(term, estimate),
y = estimate,
ymin = conf.low,
ymax = conf.high)) +
geom_hline(yintercept = 1, linetype = "dashed", color = "gray40") +
geom_pointrange(color = "#2E86C1", size = 0.9) +
coord_flip() +
labs(
title    = "Incidence Rate Ratios — Modelo Final",
subtitle = "Intervalos de confianza al 95%. IRR = 1: efecto nulo.",
x = NULL, y = "IRR"
) +
theme_minimal()
datos_std <- datos_std %>%
mutate(pred_final = predict(m_final, type = "response"),
residual   = casos_divorcio - pred_final)
ggplot(datos_std,
aes(x = pred_final, y = casos_divorcio,
color = factor(es_capital))) +
geom_abline(slope = 1, intercept = 0,
linetype = "dashed", color = "gray50", linewidth = 0.8) +
geom_point(size = 3, alpha = 0.85) +
scale_color_manual(
values = c("0" = "#2E86C1", "1" = "#E74C3C"),
labels = c("Departamentos del interior", "Capital (Guatemala)"),
name   = ""
) +
labs(
title    = "Valores reales vs. predichos — Modelo Final",
subtitle = "La línea discontinua = predicción perfecta (real = predicho).",
x = "Divorcios predichos", y = "Divorcios reales"
) +
theme_minimal() +
theme(legend.position = "bottom")
datos_std <- datos_std %>%
mutate(res_pearson = residuals(m_final, type = "pearson"))
p_res <- ggplot(datos_std,
aes(x = pred_final, y = res_pearson,
color = factor(es_capital))) +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
geom_hline(yintercept = c(-2, 2), linetype = "dotted",
color = "orange", linewidth = 0.7) +
